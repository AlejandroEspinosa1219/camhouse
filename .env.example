# Configuración del Servidor
PORT=4000
NODE_ENV=development

# Google Gemini API Key
# Obtén tu clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Rutas de Sesión Baileys
AUTH_SESSION_RECLUTAMIENTO=./auth_sessions/linea_reclutamiento
AUTH_SESSION_ADMINISTRACION=./auth_sessions/linea_administracion
